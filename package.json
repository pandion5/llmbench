{
  "name": "llmbench",
  "version": "0.11.2",
  "description": "로컬 LLM(llama.cpp router) 점검, 설치, 모니터, 벤치마크 도구",
  "main": "src/entry.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "release": "node scripts/release.js",
    "test": "node test/bench-retry.test.js && node test/proxy.test.js",
    "start:client": "set LLMBENCH_ROLE=client&& electron ."
  },
  "build": {
    "appId": "local.llmbench",
    "win": {
      "requestedExecutionLevel": "requireAdministrator"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.1"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
